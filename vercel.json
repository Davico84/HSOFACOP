{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter odontorisas-frontend build",
  "outputDirectory": "modules/frontend/dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://hs-facop-api.onrender.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://hs-facop-api.onrender.com/auth/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
