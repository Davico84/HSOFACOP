root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java y XML (backend): 4 espacios
[*.{java,xml}]
indent_size = 4

# Markdown: no recortar espacios finales (saltos de línea con doble espacio)
[*.md]
trim_trailing_whitespace = false

# Scripts de Windows: CRLF
[*.{bat,cmd}]
end_of_line = crlf
