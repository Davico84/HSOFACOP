# Copia este archivo a `secrets.properties` (ignorado por git) y rellena los valores.
# Lo consume Spring (spring.config.import) y Docker Compose (docker compose --env-file secrets.properties up -d).
# NO subir secrets.properties al repo.

# --- Base de datos ---
# DB_PORT: puerto del host donde se expone el PostgreSQL de compose.
# Si ya tienes un PostgreSQL nativo en 5432, usa otro (p. ej. 5433) y ajusta DB_URL.
# DB_CONTAINER_NAME: nombre del contenedor Docker de Postgres.
# Los valores de BD y JWT_ISSUER los escribe `pnpm project:setup` / `pnpm project:apply`
# (project.config.json); la clave de BD y el JWT_SECRET solo viven en tu secrets.properties.
DB_CONTAINER_NAME=hs-facob-db
DB_PORT=5436
DB_URL=jdbc:postgresql://localhost:5436/hsfacopdb
DB_NAME=hsfacopdb
DB_USERNAME=facop
DB_PASSWORD=cambia-esta-clave
# Pool de conexiones (opcionales; defaults en application.yml, pensados para Neon que se suspende):
# DB_POOL_MIN_IDLE=0
# DB_POOL_IDLE_TIMEOUT_MS=60000
# DB_POOL_MAX_SIZE=5

# --- Seguridad / JWT ---
# JWT_SECRET: al menos 32 BYTES aleatorios (genera uno con: openssl rand -base64 48).
# La app NO arranca si falta, si es este valor de ejemplo o si tiene menos de 32 bytes.
# `pnpm project:apply` lo genera solo al crear secrets.properties.
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
JWT_ISSUER=mi-proyecto
# Opcionales (tienen defaults en application.yml):
# JWT_ACCESS_TTL=PT15M        # Duration ISO-8601 (access token en memoria)
# JWT_REFRESH_TTL=P7D         # Duration ISO-8601 (refresh en cookie httpOnly)
# REFRESH_COOKIE_NAME=refresh_token
# COOKIE_SECURE=true          # false para http en local si es necesario
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# HEALTH_SHOW_DETAILS=always   # never en despliegue: /actuator/health sin detalle de BD ni disco
# RECORDS_DEFAULT_QUOTA=1     # cupo de historias de toda cuenta nueva (0–9999); vacío = sin límite

# --- Documentación de la API (Swagger UI y /v3/api-docs) ---
# Apagada por defecto. true solo en local/desarrollo; false o ausente en despliegue.
SWAGGER_ENABLED=true
